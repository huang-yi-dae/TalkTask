# ============================================================
# AutoTask — Vercel 自部署环境变量
# 本地：复制本文件为 .env 并填值
# Vercel：Project → Settings → Environment Variables 逐条添加
# ============================================================

# ------------------------------------------------------------
# 1) 数据库（必填）
# ------------------------------------------------------------
# Neon / Supabase / 任意 Postgres 的连接串。
# Neon 免费档拿到的串形如：
#   postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 注意 Vercel Serverless 请用 pooler（带 -pooler）那条，避免连接数打满。
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ------------------------------------------------------------
# 2) 大模型（必填，OpenAI 兼容端点）
# ------------------------------------------------------------
# 固定 byok：直连你自己的 OpenAI 兼容服务，不走任何第三方计费代理。
EAZO_AI_PROVIDER_MODE=byok

# Base URL —— 必须写到 /v1 这一层（代码会自动拼 /chat/completions）。
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Moonshot    https://api.moonshot.cn/v1
#   硅基流动     https://api.siliconflow.cn/v1
#   智谱        https://open.bigmodel.cn/api/paas/v4
#   自建 vLLM    http://your-host:8000/v1
AI_PROVIDER_BASE_URL=https://api.deepseek.com/v1

# API Key（放 Vercel 环境变量，别提交进 git）
AI_PROVIDER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型名，按你所选服务商的命名填
#   deepseek-chat / gpt-4o-mini / moonshot-v1-8k / Qwen/Qwen2.5-72B-Instruct ...
AI_PROVIDER_MODEL=deepseek-chat

# ------------------------------------------------------------
# 2.5) 联网资源检索（可选）
# ------------------------------------------------------------
# Tavily 用于"两阶段资源检索"：AI 只出搜索意图，代码调用 Tavily 从白名单
# 域名里检索真实 URL，杜绝 LLM 编造 404 链接。
# 申请：https://app.tavily.com  →  API Keys  →  新建
# 不填也能跑：缺 key 时自动降级为 search_only 模式（用户点击资源时跳转搜索引擎自己选）。
TAVILY_API_KEY=

# ------------------------------------------------------------
# 3) 演示用户（可选）
# ------------------------------------------------------------
# 自部署没有平台登录态，全站使用一个固定演示用户。
# 想换展示用的名字/邮箱就改这里。
NEXT_PUBLIC_DEMO_USER_ID=demo-learner
NEXT_PUBLIC_DEMO_USER_NAME=体验用户
NEXT_PUBLIC_DEMO_USER_EMAIL=demo@autotask.app

# ------------------------------------------------------------
# 4) 站点元信息（可选）
# ------------------------------------------------------------
NEXT_PUBLIC_APP_TITLE=AutoTask · 学习规划智能体
NEXT_PUBLIC_APP_DESCRIPTION=输入一个学习目标，自动拆解成带甘特图的可执行计划

# ------------------------------------------------------------
# 5) 定时任务密钥（可选）
# ------------------------------------------------------------
# vercel.json 里声明的 cron 会带 Authorization: Bearer ${CRON_SECRET} 回调。
# 生成：openssl rand -hex 32
CRON_SECRET=replace_with_a_long_random_string
